# Compose uses a local-only PostgreSQL development instance.
DEMO_MODE=true
LLM_PROVIDER=mock
MAX_ITERATIONS=30
MAX_LLM_TOKENS=2000
MAX_RUN_COST_EUR=0
# For private use: DEMO_MODE=false and supply MISSION_OWNER_TOKEN through your environment.
# Optional real provider (rationale refinement only): LLM_PROVIDER=openai-compatible
# Supply LLM_BASE_URL, LLM_MODEL, LLM_API_KEY, and LLM_MAX_PRICE_PER_MILLION externally.
# Never commit credentials.
